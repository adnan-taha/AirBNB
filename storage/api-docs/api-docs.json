                        "description": "Approved"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/owner/apartments": {
            "get": {
                "tags": [
                    "Apartments"
                ],
                "summary": "List owner's apartments",
