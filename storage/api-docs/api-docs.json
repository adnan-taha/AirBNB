{
    "openapi": "3.0.0",
    "info": {
        "title": "AirBNB API",
        "version": "1.2.4"
    },
    "paths": {
        "/api/apartments": {
            "get": {
                "tags": [
                    "Apartments"
                ],
                "summary": "List apartments (public)",
                "operationId": "a8e6ba6dd64e1e9208b735934467a0be",
                "parameters": [
                    {
                        "name": "city",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "province",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "min_price",
                        "in": "query",
                        "schema": {
                            "type": "number"
                        }
                    },
                    {
                        "name": "max_price",
                        "in": "query",
                        "schema": {
                            "type": "number"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List returned"
                    }
                }
            },
            "post": {
                "tags": [
                    "Apartments"
                ],
                "summary": "Create new apartment",
                "description": "Creates a new apartment. The images field should contain URLs returned from the image upload endpoint.",
                "operationId": "c40dbd16366fb6f100e6bbf98eee2768",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "province": {
                                        "type": "string"
                                    },
                                    "city": {
                                        "type": "string"
                                    },
                                    "rooms": {
                                        "type": "integer"
                                    },
                                    "price_per_day": {
                                        "type": "number",
                                        "format": "float"
                                    },
                                    "images": {
                                        "description": "Array of image URLs returned from the image upload endpoint",
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Apartment created successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Account not approved"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/apartments/{id}": {
            "get": {
                "tags": [
                    "Apartments"
                ],
                "summary": "Get apartment details",
                "operationId": "8731d0bfce1620b0c185afb5bda9c6db",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Apartment data"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            },
            "put": {
                "tags": [
                    "Apartments"
                ],
                "summary": "Update apartment (owner or admin only)",
                "description": "Updates an existing apartment. The images field should contain URLs returned from the image upload endpoint.",
                "operationId": "cee4d359c4f6b1b2e4a3e4d993b19214",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Apartment ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "province": {
                                        "type": "string"
                                    },
                                    "city": {
                                        "type": "string"
                                    },
                                    "rooms": {
                                        "type": "integer"
                                    },
                                    "price_per_day": {
                                        "type": "number",
                                        "format": "float"
                                    },
                                    "images": {
                                        "description": "Array of image URLs returned from the image upload endpoint",
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Apartment updated successfully"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Apartment not found"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Apartments"
                ],
                "summary": "Delete apartment (owner or admin)",
                "operationId": "1d3397cf004ec4489ac4691d8aa3b72e",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Deleted"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/apartments/{id}/approve": {
