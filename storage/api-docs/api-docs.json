        "/api/apartment/unapproved": {
            "get": {
                "tags": [
                    "Apartments"
                ],
                "summary": "Get all unapproved apartments",
                "description": "Returns a list of all apartments that are not yet approved. Admin only.",
                "operationId": "c9f4abc5cf949868a30d66de3d9c637a",
                "responses": {
                    "200": {
                        "description": "List of unapproved apartments",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "title": {
                                                "type": "string",
                                                "example": "My Apartment"
                                            },
                                            "description": {
                                                "type": "string",
                                                "example": "Nice place to stay"
                                            },
                                            "province": {
                                                "type": "string",
                                                "example": "Damascus"
                                            },
                                            "city": {
                                                "type": "string",
                                                "example": "CityName"
                                            },
                                            "rooms": {
                                                "type": "integer",
                                                "example": 2
                                            },
                                            "price_per_day": {
                                                "type": "number",
                                                "format": "float",
                                                "example": 100
                                            },
                                            "owner_id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "images": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                },
                                                "example": [
                                                    "url1",
                                                    "url2"
                                                ]
                                            },
                                            "is_approved": {
                                                "type": "boolean",
                                                "example": false
                                            },
                                            "created_at": {
                                                "type": "string",
                                                "format": "date-time"
                                            },
                                            "updated_at": {
                                                "type": "string",
                                                "format": "date-time"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No unapproved apartments found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "No unapproved apartments found"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Forbidden"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register a new user (tenant or owner)",
                "description": "Creates a new user account. User must be approved by admin before login.",
                "operationId": "8a56853624e025573120a09a4c75d468",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "phone",
                                    "password",
                                    "role"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "Adnan"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Khalil"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "0999999999"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "adnan@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "123456"
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "tenant",
                                            "owner"
                                        ],
                                        "example": "tenant"
                                    },
                                    "birth_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2000-05-10"
                                    },
                                    "photo": {
                                        "type": "string",
                                        "format": "url",
                                        "example": "http://localhost:8000/storage/uploads/gqeLHBemszfLGTBJjJDIkPsarbPs125oqAU6OcnA.jpg"
                                    },
                                    "id_photo_front": {
                                        "type": "string",
                                        "format": "url",
                                        "example": "http://localhost:8000/storage/uploads/gqeLHBemszfLGTBJjJDIkPsarbPs125oqAU6OcnA.jpg"
                                    },
                                    "id_photo_back": {
                                        "type": "string",
                                        "format": "url",
                                        "example": "http://localhost:8000/storage/uploads/gqeLHBemszfLGTBJjJDIkPsarbPs125oqAU6OcnA.jpg"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Registered successfully. Wait for admin approval."
                                        },
                                        "user": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login user",
                "description": "Logs in a user using phone and password. Requires admin approval.",
                "operationId": "a3b306d14572d1f4bd6c064b3233e7b8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone",
                                    "password"
                                ],
                                "properties": {
                                    "phone": {
                                        "type": "string",
                                        "example": "0999999999"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "12345"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Login successful"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|asdfasfsdafasdfadsfasdf"
                                        },
                                        "user": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "User not approved by admin"
                    },
                    "401": {
                        "description": "Invalid phone or password"
                    }
                }
            }
        },
